VITE_PARTNER_PROFILE=hibob
VITE_CLIENT_ID=hibob-local-demo
VITE_CLIENT_SECRET=hibob-local-secret
VITE_REMOTE_GATEWAY=local
# No VITE_REFRESH_TOKEN — the POC gets one from company creation and stores it
# in server/session.json. Adding one here would point the SDK at a DIFFERENT
# company than the one created during the demo, silently.
# Maps to credentials seeded by ~/cursor/tiger/tiger/apps/tiger/priv/scripts/setup_hibob_demo.exs
